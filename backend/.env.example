# Server Setup
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai_pr_bot?retryWrites=true&w=majority
JWT_SECRET=your_jwt_signing_key_here

# GitHub App Credentials
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=Iv1.xxx
GITHUB_CLIENT_SECRET=github_client_secret_here
GITHUB_WEBHOOK_SECRET=your_configured_webhook_secret
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# AI Service
GEMINI_API_KEY=your_gemini_api_key_here

# Client Redirection
CLIENT_URL=http://localhost:3000
