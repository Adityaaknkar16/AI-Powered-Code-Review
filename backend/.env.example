# ==========================================
# BACKEND SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development

# ------------------------------------------
# DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------
# Option A: Cloud MongoDB Atlas (Free tier at https://www.mongodb.com/cloud/atlas)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_pr_bot?retryWrites=true&w=majority

# Option B: Local MongoDB instance
MONGO_URI=mongodb://localhost:27017/ai_pr_bot

# ------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------
JWT_SECRET=your_secure_jwt_random_secret_here

# ------------------------------------------
# FRONTEND / CLIENT URL (CORS)
# ------------------------------------------
CLIENT_URL=http://localhost:5173,http://localhost:3000

# ------------------------------------------
# GOOGLE GEMINI AI API
# Free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------
# GITHUB APP INTEGRATION (Optional for mock/dev mode)
# ------------------------------------------
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
